nextflow_process {

    name "Test Process INSTANEXUS_ASSEMBLE"
    script "../main.nf"
    process "INSTANEXUS_ASSEMBLE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "instanexus"
    tag "instanexus/assemble"

    test("bsa - csv - dbg") {

        when {
            params {
                module_args = "--assembly-mode dbg --kmer-size 7 --min-overlap 3 --size-threshold 12"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/instanexus/bsa_cleaned.csv', checkIfExists: true),
                ]
                """
            }
        }

        then {
            // Scaffolds of equal length are written in hash-seed-dependent order, so snapshot the sorted sequences
            def sequences = process.out.scaffolds.collect { meta, fasta ->
                [ meta, file(fasta).name, path(fasta).readLines().findAll { !it.startsWith('>') }.sort() ]
            }
            assert process.success
            assertAll(
                { assert sequences[0][2].size() > 0 },
                { assert snapshot(
                    sequences,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("bsa - csv - dbg - stub") {

        options "-stub"

        when {
            params {
                module_args = "--assembly-mode dbg --kmer-size 7 --min-overlap 3 --size-threshold 12"
            }
            process {
                """
                input[0] = channel.of('cleaned_preds\\nPEPTIDE\\n')
                    .collectFile(name: 'test.csv')
                    .map { csv -> [ [ id:'test' ], csv ] }
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}

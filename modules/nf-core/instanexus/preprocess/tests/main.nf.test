nextflow_process {

    name "Test Process INSTANEXUS_PREPROCESS"
    script "../main.nf"
    process "INSTANEXUS_PREPROCESS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_nfcore"
    tag "instanexus"
    tag "instanexus/preprocess"

    test("bsa - csv - contaminants - metadata") {

        when {
            params {
                module_args = "--conf 0.9 --fdr 0.01"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/instanexus/bsa.csv', checkIfExists: true),
                ]
                input[1] = file(params.modules_testdata_base_path + 'proteomics/instanexus/contaminants.fasta', checkIfExists: true)
                input[2] = file(params.modules_testdata_base_path + 'proteomics/instanexus/sample_metadata.json', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.csv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("bsa - csv") {

        when {
            params {
                module_args = "--conf 0.9 --fdr 0.01"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file(params.modules_testdata_base_path + 'proteomics/instanexus/bsa.csv', checkIfExists: true),
                ]
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.csv,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("bsa - csv - stub") {

        options "-stub"

        when {
            params {
                module_args = "--conf 0.9 --fdr 0.01"
            }
            process {
                """
                input[0] = channel.of('prediction_untokenised,calibrated_confidence\\nPEPTIDE,0.95\\n')
                    .collectFile(name: 'test.csv')
                    .map { csv -> [ [ id:'test' ], csv ] }
                input[1] = []
                input[2] = []
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
